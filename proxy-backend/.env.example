# Database
DATABASE_URL="postgresql://user:password@localhost:5432/proxy_backend?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="24h"

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-bucket-name"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# M-Pesa
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_SHORTCODE="your-shortcode"
MPESA_PASSKEY="your-passkey"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
MPESA_API_URL="https://sandbox.safaricom.co.ke"

# ETIMS (Kenya Revenue Authority)
ETIMS_API_URL="https://etims-api-sbx.kra.go.ke"
ETIMS_API_KEY="your-etims-api-key"
ETIMS_TIN="your-tax-identification-number"

# Application
PORT=3000
NODE_ENV="development"
